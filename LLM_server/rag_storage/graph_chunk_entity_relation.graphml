    <node id="Rajjo Gujjar">
      <data key="d0">Rajjo Gujjar</data>
      <data key="d1">Person</data>
      <data key="d2">Rajjo Gujjar   is the creator of the Discord bot.&lt;SEP&gt;Rajjo Gujjar is a comprehensive, feature-rich Discord bot built with Python that combines AI-powered conversational capabilities with traditional Discord bot functionality.</data>
