    <node id="Bot Token">
      <data key="d0">Bot Token</data>
      <data key="d1">Concept</data>
      <data key="d2">The bot token is a unique identifier used to authenticate the Discord bot.</data>
      <data key="d3">chunk-5e3e568634fa88961bff7dd56df3bb43</data>
      <data key="d4">pdf_82e6ce95.pdf</data>
      <data key="d5">1758307704</data>
